# Copy to backend/.env.production and fill in real values.
# DATABASE_URL / DATABASE_URL_SYNC are set by docker-compose.prod.yml itself
# (they read POSTGRES_PASSWORD below) — you don't need to repeat them here.

# Postgres password used by both the postgres and api services
POSTGRES_PASSWORD=change-me-generate-a-real-password

# Auth — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — the real domain, HTTPS
CORS_ORIGINS=https://inf.dialdesk.in

# First admin account, created by the seed script on first boot (idempotent —
# skipped on every later restart once it exists)
SEED_ADMIN_EMAIL=kunal@sotrue.com
SEED_ADMIN_PASSWORD=change-me-then-log-in-and-change-again
SEED_ADMIN_NAME=Kunal Khurana

# File uploads (creator attachments)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=26214400

# Team size — how many advisor accounts can be active at once. To raise it,
# change this value and redeploy (docker compose ... up -d --build); no code
# change needed.
MAX_ACTIVE_ADVISORS=10
